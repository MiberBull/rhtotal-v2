<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="0.0.10-001" author="dchkw">
        <comment>Add demo tenant for multi-tenant isolation testing</comment>
        <insert tableName="w_tenant" schemaName="public">
            <column name="id_tenant" value="demo-corp"/>
            <column name="ds_name" value="Demo Corporation"/>
            <column name="ds_domain" value="demo.dchkw.com.mx"/>
            <column name="fg_active" valueBoolean="true"/>
            <column name="dt_creation_date" valueComputed="NOW()"/>
        </insert>
        <rollback>
            <delete tableName="w_tenant" schemaName="public">
                <where>id_tenant = 'demo-corp'</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
