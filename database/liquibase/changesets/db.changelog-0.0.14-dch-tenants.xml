        <comment>Tenants reales DCH: AEISA, RGA, Staffing</comment>

        <insert tableName="w_tenant" schemaName="public">
            <column name="id_tenant" value="aeisa"/>
            <column name="ds_name" value="AEISA S.A. de C.V."/>
            <column name="ds_domain" value="aeisa.dch.mx"/>
            <column name="fg_active" valueBoolean="true"/>
            <column name="dt_creation_date" valueComputed="NOW()"/>
