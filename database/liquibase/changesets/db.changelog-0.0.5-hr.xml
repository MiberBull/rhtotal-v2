    <!-- ===== VACACIONES ===== -->

    <!-- 0.0.5-001: Tabla k_vacation_balance (saldo LFT por empleado) -->
    <changeSet id="0.0.5-001" author="dch-knowwho">
        <createTable tableName="k_vacation_balance" schemaName="public">
            <column name="id_balance" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(50)" defaultValue="dchkw">
                <constraints nullable="false"/>
            </column>
            <column name="id_employee" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="nb_year_of_service" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="nb_days_entitled" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="nb_days_taken" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="nb_days_pending" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="dt_period_start" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="dt_period_end" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="fg_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="dt_creation_date" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="dt_modification_date" type="TIMESTAMP"/>
            <column name="ds_creation_user" type="VARCHAR(200)"/>
            <column name="ds_modification_user" type="VARCHAR(200)"/>
        </createTable>
    </changeSet>

    <changeSet id="0.0.5-002" author="dch-knowwho">
        <addForeignKeyConstraint
            baseTableSchemaName="public"
            baseTableName="k_vacation_balance"
            baseColumnNames="tenant_id"
            constraintName="fk_k_vacation_balance_tenant"
            referencedTableSchemaName="public"
            referencedTableName="w_tenant"
            referencedColumnNames="id_tenant"/>
    </changeSet>

    <!-- 0.0.5-003: Tabla k_vacation_request (solicitudes de vacaciones) -->
