            <column name="nb_days_requested" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="ds_status" type="VARCHAR(50)" defaultValue="PENDIENTE">
                <constraints nullable="false"/>
            </column>
            <column name="ds_notes" type="TEXT"/>
