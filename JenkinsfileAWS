pipeline {
    agent any
    /*agent {
        label 'RhTotal'
    }*/
    environment {
        DB_PASS_PROD = credentials('db-pass-prod')
        AWS_ACCOUNT_ID = credentials('aws-account-id')
        EC2_HOST = credentials('ec2-hostname')
        RDS_HOST = credentials('rds-endpoint')
        AES_SECRET_KEY = credentials('aes-secret-key')
    }
    tools {
        maven 'M3'
        jdk 'jdk21'
    }
    stages {
        stage('Set Version') {
            when { branch 'main' }
            steps {
                script {
                    env.IMAGE_VERSION = sh(
                        returnStdout: true,
                        script: "git describe --tags --always 2>/dev/null || git rev-parse --short HEAD"
                    ).trim()
                    echo "IMAGE_VERSION = ${env.IMAGE_VERSION}"
                }
            }
        }
        stage('Build Components') {
            when { branch 'main' }
            failFast true
            parallel {
                stage('Build Eureka') {
                    steps {
                        echo 'Building Eureka Service Spring boot'
                        dir ('eureka-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Gateway') {
                    steps {
                        echo 'Building Webservice Spring boot'
                        dir ('gateway-service/src/main/resources/'){
                            sh 'sed -i "s/gatewayservice/${EC2_HOST}/g" application.yml'
                        }
                        dir ('gateway-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Security') {
                    steps {
                        echo 'Building Webservice Security Spring boot'
                        dir ('security-service/security-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/${RDS_HOST}:5432/g" application.yml'
                            sh 'sed -i "s/unbound/rhtotal/g" application.yml'
                            sh 'sed -i "s/username: postgres/username: rhtotal/g" application.yml'
                            sh 'sed -i "s/project123/${DB_PASS_PROD}/g" application.yml'
                            sh 'sed -i "s/gatewayservice/${EC2_HOST}/g" application.yml'
                        }
                        dir ('security-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Application') {
                    steps {
                        echo 'Building Webservice Spring boot'
                        dir ('application-service/application-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/${RDS_HOST}:5432/g" application.yml'
                            sh 'sed -i "s/unbound/rhtotal/g" application.yml'
                            sh 'sed -i "s/username: postgres/username: rhtotal/g" application.yml'
                            sh 'sed -i "s/project123/${DB_PASS_PROD}/g" application.yml'
                            sh 'sed -i "s/gatewayservice/${EC2_HOST}/g" application.yml'
                        }
                        dir ('application-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build User') {
                    steps {
                        echo 'Building Webservice Spring boot'
                        dir ('user-service/user-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/${RDS_HOST}:5432/g" application.yml'
                            sh 'sed -i "s/unbound/rhtotal/g" application.yml'
                            sh 'sed -i "s/username: postgres/username: rhtotal/g" application.yml'
                            sh 'sed -i "s/project123/${DB_PASS_PROD}/g" application.yml'
                            sh 'sed -i "s/gatewayservice/${EC2_HOST}/g" application.yml'
                        }
                        dir ('user-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Onboarding') {
                    steps {
                        echo 'Building Onboarding Service Spring boot'
                        dir ('onboarding-service/onboarding-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/${RDS_HOST}:5432/g" application.yml'
                            sh 'sed -i "s/unbound/rhtotal/g" application.yml'
                            sh 'sed -i "s/username: postgres/username: rhtotal/g" application.yml'
                            sh 'sed -i "s/project123/${DB_PASS_PROD}/g" application.yml'
                            sh 'sed -i "s/gatewayservice/${EC2_HOST}/g" application.yml'
                        }
                        dir ('onboarding-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Attendance') {
                    steps {
                        echo 'Building Attendance Service Spring boot'
                        dir ('attendance-service/attendance-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/${RDS_HOST}:5432/g" application.yml'
                            sh 'sed -i "s/unbound/rhtotal/g" application.yml'
                            sh 'sed -i "s/username: postgres/username: rhtotal/g" application.yml'
                            sh 'sed -i "s/project123/${DB_PASS_PROD}/g" application.yml'
                            sh 'sed -i "s/gatewayservice/${EC2_HOST}/g" application.yml'
                        }
                        dir ('attendance-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build HR') {
                    steps {
                        echo 'Building HR Service Spring boot'
                        dir ('hr-service/hr-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/${RDS_HOST}:5432/g" application.yml'
                            sh 'sed -i "s/unbound/rhtotal/g" application.yml'
                            sh 'sed -i "s/username: postgres/username: rhtotal/g" application.yml'
                            sh 'sed -i "s/project123/${DB_PASS_PROD}/g" application.yml'
                            sh 'sed -i "s/gatewayservice/${EC2_HOST}/g" application.yml'
                        }
                        dir ('hr-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Document') {
                    steps {
                        echo 'Building Document Service Spring boot'
                        dir ('document-service/document-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/${RDS_HOST}:5432/g" application.yml'
                            sh 'sed -i "s/unbound/rhtotal/g" application.yml'
                            sh 'sed -i "s/username: postgres/username: rhtotal/g" application.yml'
                            sh 'sed -i "s/project123/${DB_PASS_PROD}/g" application.yml'
                            sh 'sed -i "s/gatewayservice/${EC2_HOST}/g" application.yml'
                        }
                        dir ('document-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Frontend Mobile') {
                    steps {
                        echo 'Building Frontend Mobile Ionic 3 PROD (Node 12)'
                        dir ('frontend-mobile/src/environments/'){
                            sh 'sed -i "s/REPLACE_WITH_AES_SECRET/${AES_SECRET_KEY}/g" environments.ts'
                        }
                        dir ('frontend-mobile/'){
                            sh '. ~/.nvm/nvm.sh && nvm use 12 && npm rebuild node-sass && npx ionic build --prod'
                        }
                    }
                }
                stage('Build Web Admin') {
                    steps {
                        echo 'Injecting secrets for Web Admin Docker build (multi-stage: build runs inside Docker)'
                        dir ('apps/web-admin/src/environments/'){
                            sh 'sed -i "s/REPLACE_WITH_AES_SECRET/${AES_SECRET_KEY}/g" environment.ts'
                            sh 'sed -i "s/REPLACE_WITH_AES_SECRET/${AES_SECRET_KEY}/g" environment.prod.ts'
                        }
                    }
                }
            }
        }
        stage('Docker build') {
            when { branch 'main' }
            steps {
                echo 'Build Docker images'
                sh 'docker build -f "Dockerfile-eureka-service"     -t rhtotal-eureka-service .'
                sh 'docker build -f "Dockerfile-gateway-service"    -t rhtotal-gateway-service .'
                sh 'docker build -f "Dockerfile-application-service" -t rhtotal-application-repository .'
                sh 'docker build -f "Dockerfile-security-service"   -t rhtotal-security-repository .'
                sh 'docker build -f "Dockerfile-user-service"       -t rhtotal-user-repository .'
                sh 'docker build -f "Dockerfile-onboarding-service" -t rhtotal-onboarding-repository .'
                sh 'docker build -f "Dockerfile-attendance-service" -t rhtotal-attendance-repository .'
                sh 'docker build -f "Dockerfile-hr-service"         -t rhtotal-hr-repository .'
                sh 'docker build -f "Dockerfile-document-service"   -t rhtotal-document-repository .'
                sh 'docker build -f "Dockerfile-web-admin"          -t rhtotal-web-admin-repository .'
            }
        }
        stage('Docker tag') {
            when { branch 'main' }
            steps {
                echo 'Tag Docker images'
                sh 'docker tag rhtotal-eureka-service:latest          ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-eureka-service:$IMAGE_VERSION'
                sh 'docker tag rhtotal-gateway-service:latest         ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-gateway-service:$IMAGE_VERSION'
                sh 'docker tag rhtotal-application-repository:latest  ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-application-repository:$IMAGE_VERSION'
                sh 'docker tag rhtotal-security-repository:latest     ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-security-repository:$IMAGE_VERSION'
                sh 'docker tag rhtotal-user-repository:latest         ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-user-repository:$IMAGE_VERSION'
                sh 'docker tag rhtotal-onboarding-repository:latest   ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-onboarding-repository:$IMAGE_VERSION'
                sh 'docker tag rhtotal-attendance-repository:latest   ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-attendance-repository:$IMAGE_VERSION'
                sh 'docker tag rhtotal-hr-repository:latest           ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-hr-repository:$IMAGE_VERSION'
                sh 'docker tag rhtotal-document-repository:latest     ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-document-repository:$IMAGE_VERSION'
                sh 'docker tag rhtotal-web-admin-repository:latest    ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-web-admin-repository:$IMAGE_VERSION'
            }
        }
        stage('Docker push') {
            when { branch 'main' }
            steps {
                echo 'Login to ECR'
                sh 'aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com'
                echo 'Push to AWS ECR'
                sh 'docker push ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-eureka-service:$IMAGE_VERSION'
                sh 'docker push ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-gateway-service:$IMAGE_VERSION'
                sh 'docker push ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-application-repository:$IMAGE_VERSION'
                sh 'docker push ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-security-repository:$IMAGE_VERSION'
                sh 'docker push ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-user-repository:$IMAGE_VERSION'
                sh 'docker push ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-onboarding-repository:$IMAGE_VERSION'
                sh 'docker push ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-attendance-repository:$IMAGE_VERSION'
                sh 'docker push ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-hr-repository:$IMAGE_VERSION'
                sh 'docker push ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-document-repository:$IMAGE_VERSION'
                sh 'docker push ${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/rhtotal-web-admin-repository:$IMAGE_VERSION'
            }
        }
        stage('Liquibase') {
            when { branch 'main' }
            steps {
                echo 'Running Liquibase migrations on RDS'
                sleep 10
                dir ('database/liquibase/'){
                    sh """$LIQUIBASE_PATH/liquibase \
                        --url=jdbc:postgresql://${RDS_HOST}:5432/rhtotal \
                        --username=rhtotal \
                        --password=${DB_PASS_PROD} \
                        --changeLogFile="changesets/db.changelog-master.xml" \
                        update"""
                }
            }
        }
    }
    post {
        always {
            deleteDir()
        }
        success {
            echo 'I succeeeded!'
        }
        unstable {
            echo 'I am unstable :/'
        }
        failure {
            echo 'I failed :('
        }
        changed {
            echo 'Things were different before...'
        }
    }
}
