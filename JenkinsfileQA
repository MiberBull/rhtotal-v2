pipeline {
    agent any
    /*agent {
        label 'RhTotal'
    }*/
    environment {
        SONAR_TOKEN = credentials('sonarqube-token')
        AES_SECRET_KEY = credentials('aes-secret-key')
    }
    tools {
        maven 'M3'
        jdk 'jdk21'
    }
    stages {
        stage('Build Components') {
            when { branch pattern: 'release/.*', comparator: 'REGEXP' }
            failFast true
            parallel {
                stage('Build Eureka') {
                    steps {
                        echo 'Building Eureka Service Spring boot'
                        dir ('eureka-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Gateway') {
                    steps {
                        echo 'Building Webservice Spring boot'
                        dir ('gateway-service/src/main/resources/'){
                            sh 'sed -i "s/port: 8000/port: 9000/g" application.yml'
                        }
                        dir ('gateway-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Security') {
                    steps {
                        echo 'Building Webservice Security Spring boot'
                        dir ('security-service/security-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/postgresqa:5432/g" application.yml'
                            sh 'sed -i "s/gatewayservice:8000/gatewayservice:9000/g" application.yml'
                            sh 'sed -i "s/port: 8090/port: 9090/g" application.yml'
                        }
                        dir ('security-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Application') {
                    steps {
                        echo 'Building Webservice Spring boot'
                        dir ('application-service/application-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/postgresqa:5432/g" application.yml'
                            sh 'sed -i "s/gatewayservice:8000/gatewayservice:9000/g" application.yml'
                            sh 'sed -i "s/port: 8091/port: 9091/g" application.yml'
                        }
                        dir ('application-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build User') {
                    steps {
                        echo 'Building Webservice Spring boot'
                        dir ('user-service/user-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/postgresqa:5432/g" application.yml'
                            sh 'sed -i "s/gatewayservice:8000/gatewayservice:9000/g" application.yml'
                            sh 'sed -i "s/port: 8092/port: 9092/g" application.yml'
                        }
                        dir ('user-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Onboarding') {
                    steps {
                        echo 'Building Onboarding Service Spring boot'
                        dir ('onboarding-service/onboarding-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/postgresqa:5432/g" application.yml'
                            sh 'sed -i "s/gatewayservice:8000/gatewayservice:9000/g" application.yml'
                            sh 'sed -i "s/port: 8093/port: 9093/g" application.yml'
                        }
                        dir ('onboarding-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Attendance') {
                    steps {
                        echo 'Building Attendance Service Spring boot'
                        dir ('attendance-service/attendance-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/postgresqa:5432/g" application.yml'
                            sh 'sed -i "s/gatewayservice:8000/gatewayservice:9000/g" application.yml'
                            sh 'sed -i "s/port: 8094/port: 9094/g" application.yml'
                        }
                        dir ('attendance-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build HR') {
                    steps {
                        echo 'Building HR Service Spring boot'
                        dir ('hr-service/hr-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/postgresqa:5432/g" application.yml'
                            sh 'sed -i "s/gatewayservice:8000/gatewayservice:9000/g" application.yml'
                            sh 'sed -i "s/port: 8095/port: 9095/g" application.yml'
                        }
                        dir ('hr-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Document') {
                    steps {
                        echo 'Building Document Service Spring boot'
                        dir ('document-service/document-web/src/main/resources/'){
                            sh 'sed -i "s/postgres:5432/postgresqa:5432/g" application.yml'
                            sh 'sed -i "s/gatewayservice:8000/gatewayservice:9000/g" application.yml'
                            sh 'sed -i "s/port: 8096/port: 9096/g" application.yml'
                        }
                        dir ('document-service/'){
                            sh 'mvn clean package'
                        }
                    }
                }
                stage('Build Frontend Web') {
                    steps {
                        echo 'Building Frontend Web Angular 6 QA (Node 12)'
                        dir ('frontend-web/src/environments/'){
                            sh 'sed -i "s/REPLACE_WITH_AES_SECRET/${AES_SECRET_KEY}/g" environment.ts'
                            sh 'sed -i "s/REPLACE_WITH_AES_SECRET/${AES_SECRET_KEY}/g" environment.prod.ts'
                            sh 'sed -i "s/192.168.0.65:8000/192.168.0.65:9000/g" environment.prod.ts'
                            sh 'sed -i "s/192.168.0.65:8000/192.168.0.65:9000/g" environment.ts'
                        }
                        dir ('frontend-web/'){
                            sh '. ~/.nvm/nvm.sh && nvm use 12 && npm install && npm run build -- --configuration=production'
                        }
                    }
                }
                stage('Build Frontend Mobile') {
                    steps {
                        echo 'Building Frontend Mobile Ionic 3 QA (Node 12)'
                        dir ('frontend-mobile/src/environments/'){
                            sh 'sed -i "s/REPLACE_WITH_AES_SECRET/${AES_SECRET_KEY}/g" environments.ts'
                        }
                        dir ('frontend-mobile/'){
                            sh '. ~/.nvm/nvm.sh && nvm use 12 && npm rebuild node-sass && npx ionic build --prod'
                        }
                    }
                }
                stage('Build Web Admin') {
                    steps {
                        echo 'Building Web Admin Angular 19 QA (Node 22)'
                        dir ('apps/web-admin/src/environments/'){
                            sh 'sed -i "s/REPLACE_WITH_AES_SECRET/${AES_SECRET_KEY}/g" environment.ts'
                            sh 'sed -i "s/REPLACE_WITH_AES_SECRET/${AES_SECRET_KEY}/g" environment.prod.ts'
                            sh 'sed -i "s|http://localhost:8000|http://192.168.0.65:9000|g" environment.ts'
                            sh 'sed -i "s|http://localhost:8000|http://192.168.0.65:9000|g" environment.prod.ts'
                        }
                        dir ('apps/web-admin/'){
                            sh 'npm install'
                            sh 'npm run build'
                        }
                    }
                }
            }
        }
        stage('Sonar Analisis') {
            when { branch pattern: 'release/.*', comparator: 'REGEXP' }
            failFast true
            parallel {
                stage('Sonar Security') {
                    tools { jdk "jdk21" }
                    steps {
                        dir ('security-service/'){
                            sh 'mvn sonar:sonar \
                                -Dsonar.projectKey=DCH_Total_Security \
                                -Dsonar.projectName=DCH_Total_Security \
                                -Dsonar.sources=src/main \
                                -Dsonar.tests=src/test \
                                -Dsonar.coverage.exclusions=**/*TO.java,**/*DO.java \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN}'
                        }
                    }
                }
                stage('Sonar Application') {
                    tools { jdk "jdk21" }
                    steps {
                        dir ('application-service/'){
                            sh 'mvn sonar:sonar \
                                -Dsonar.projectKey=DCH_Total_Application \
                                -Dsonar.projectName=DCH_Total_Application \
                                -Dsonar.sources=src/main \
                                -Dsonar.tests=src/test \
                                -Dsonar.coverage.exclusions=**/*TO.java,**/*DO.java \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN}'
                        }
                    }
                }
                stage('Sonar User') {
                    tools { jdk "jdk21" }
                    steps {
                        dir ('user-service/'){
                            sh 'mvn sonar:sonar \
                                -Dsonar.projectKey=DCH_Total_User \
                                -Dsonar.projectName=DCH_Total_User \
                                -Dsonar.sources=src/main \
                                -Dsonar.tests=src/test \
                                -Dsonar.coverage.exclusions=**/*TO.java,**/*DO.java \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN}'
                        }
                    }
                }
                stage('Sonar Onboarding') {
                    tools { jdk "jdk21" }
                    steps {
                        dir ('onboarding-service/'){
                            sh 'mvn sonar:sonar \
                                -Dsonar.projectKey=DCH_Total_Onboarding \
                                -Dsonar.projectName=DCH_Total_Onboarding \
                                -Dsonar.sources=src/main \
                                -Dsonar.tests=src/test \
                                -Dsonar.coverage.exclusions=**/*TO.java,**/*DO.java \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN}'
                        }
                    }
                }
                stage('Sonar Attendance') {
                    tools { jdk "jdk21" }
                    steps {
                        dir ('attendance-service/'){
                            sh 'mvn sonar:sonar \
                                -Dsonar.projectKey=DCH_Total_Attendance \
                                -Dsonar.projectName=DCH_Total_Attendance \
                                -Dsonar.sources=src/main \
                                -Dsonar.tests=src/test \
                                -Dsonar.coverage.exclusions=**/*TO.java,**/*DO.java \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN}'
                        }
                    }
                }
                stage('Sonar HR') {
                    tools { jdk "jdk21" }
                    steps {
                        dir ('hr-service/'){
                            sh 'mvn sonar:sonar \
                                -Dsonar.projectKey=DCH_Total_HR \
                                -Dsonar.projectName=DCH_Total_HR \
                                -Dsonar.sources=src/main \
                                -Dsonar.tests=src/test \
                                -Dsonar.coverage.exclusions=**/*TO.java,**/*DO.java \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN}'
                        }
                    }
                }
                stage('Sonar Document') {
                    tools { jdk "jdk21" }
                    steps {
                        dir ('document-service/'){
                            sh 'mvn sonar:sonar \
                                -Dsonar.projectKey=DCH_Total_Document \
                                -Dsonar.projectName=DCH_Total_Document \
                                -Dsonar.sources=src/main \
                                -Dsonar.tests=src/test \
                                -Dsonar.coverage.exclusions=**/*TO.java,**/*DO.java \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONAR_TOKEN}'
                        }
                    }
                }
            }
        }
        stage('Docker up') {
            when { branch pattern: 'release/.*', comparator: 'REGEXP' }
            steps {
                echo 'Running on Docker QA'
                sh 'docker network disconnect rhtotalqa_rhtotalqanet postgresqa || true'
                sh 'docker-compose -f docker-composeQA.yml down --rmi all'
                sh 'docker-compose -f docker-composeQA.yml up -d'
                sh 'docker network connect rhtotalqa_rhtotalqanet postgresqa || true'
            }
        }
        stage('Liquibase') {
            when { branch pattern: 'release/.*', comparator: 'REGEXP' }
            steps {
                echo 'Running Liquibase migrations'
                sleep 10
                dir ('database/liquibase/'){
                    sh 'sed -i "s/localhost:5432/localhost:5430/g" liquibase.properties'
                    sh '$LIQUIBASE_PATH/liquibase --changeLogFile="changesets/db.changelog-master.xml" update'
                }
            }
        }
    }
    post {
        always {
            deleteDir()
        }
        success {
            echo 'I succeeeded!'
        }
        unstable {
            sh 'docker-compose -f docker-composeQA.yml down'
            echo 'I am unstable :/'
        }
        failure {
            sh 'docker-compose -f docker-composeQA.yml down'
            echo 'I failed :('
        }
        changed {
            echo 'Things were different before...'
        }
    }
}
